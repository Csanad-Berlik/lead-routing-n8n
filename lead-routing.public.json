    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Flatten').first().json;\nconst company = $json;\n\nconst known = company.employee_count !== undefined && \n  company.employee_count !== null;\nconst employees = Number(company.employee_count);\nconst targetCountries = ['US', 'GB', 'DE', 'NL'];\n\nlet points = 0;\n\nif (employees >= 51 && employees <= 500) {\n  points += 2;\n} else if ((employees >= 11 && employees <= 50) || (employees >= 501 && employees <= 2000)) {\n  points += 1;\n}\n\nif (targetCountries.includes(company.country)) {\n  points += 1;\n}\n\nif (/\\b(founder|chief|vp|vice president|head|director)\\b/i.test(lead.job_title)) {\n  points += 1;\n}\n\nlet grade = 'Unknown';\nlet reason = 'Company not in the list, check by hand';\n\nif (known) {\n  if (points >= 4) {\n    grade = 'A';\n  } else if (points >= 2) {\n    grade = 'B';\n  } else {\n    grade = 'C';\n  }\n  const pointWord = points === 1 ? 'point' : 'points';\n    reason = `Grade ${grade} (${points} ${pointWord}):  \n    ${employees} employees, ${company.country}, \n    ${lead.job_title}`;\n}\n\nreturn { json: { ...lead, points, grade, reason } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
